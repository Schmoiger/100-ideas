#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: verify Typst formatting rules for staged Markdown files
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$SCRIPT_DIR/../validators/verify_typst_formatting.py"

if [ -f "$SCRIPT" ]; then
    if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
        "$VIRTUAL_ENV/bin/python" "$SCRIPT" --staged
    elif command -v uv >/dev/null 2>&1 && uv run python --version >/dev/null 2>&1; then
        uv run python "$SCRIPT" --staged
    else
        python3 "$SCRIPT" --staged
    fi
fi
